# ---------------------------------------------------------------------------
# Copy to .env and fill in real values
# ---------------------------------------------------------------------------

# DEV  -> SQLite
DATABASE_URL="file:./dev.db"

# PROD -> PostgreSQL (also change `provider` in prisma/schema.prisma)
# DATABASE_URL="postgresql://user:password@host:5432/smart_buzzer?schema=public"

# Long random string — signs session cookies. NEVER reuse the dev value.
SESSION_SECRET="replace-with-a-long-random-secret"

# Public base URL of the platform (used to build QR tracking links)
PUBLIC_APP_URL="http://localhost:3000"

# Web Push (VAPID) for lock-screen & background notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:support@smartbuzzer.app"
